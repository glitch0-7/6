<Window x:Class="ThreadsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 3. Многопоточное приложение: шарики, приоритеты, синхронизация"
        Width="920" Height="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Полотно движения: координаты шариков вычисляются в потоках -->
        <GroupBox Grid.Column="0" Header="Полотно движения (3 потока: Highest / Normal / Lowest)">
            <Canvas x:Name="pitch" Width="270" Height="270"
                    Background="White" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Canvas.LayoutTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Canvas.LayoutTransform>
            </Canvas>
        </GroupBox>

        <!-- Кнопки управления и демо; лог всех действий -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Симуляция движения:" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="startButton" Content="Запустить шарики"
                            Width="140" Height="30" Margin="0,0,6,6"
                            Click="startButton_Click" />
                    <Button x:Name="stopButton" Content="Остановить (Join+Barrier)"
                            Width="180" Height="30" Margin="0,0,6,6"
                            Click="stopButton_Click" />
                    <Button x:Name="reportButton" Content="Анализ потоков"
                            Width="130" Height="30" Margin="0,0,6,6"
                            Click="reportButton_Click" />
                </WrapPanel>

                <TextBlock Text="Демонстрации синхронизации и TPL:" FontWeight="Bold" Margin="0,0,0,4" />
                <WrapPanel>
                    <Button x:Name="lockDemoButton" Content="Lock и Monitor"
                            Width="130" Height="30" Margin="0,0,6,6"
                            Click="lockDemoButton_Click" />
                    <Button x:Name="mutexDemoButton" Content="Мьютекс"
                            Width="110" Height="30" Margin="0,0,6,6"
                            Click="mutexDemoButton_Click" />
                    <Button x:Name="semaphoreDemoButton" Content="Семафор"
                            Width="110" Height="30" Margin="0,0,6,6"
                            Click="semaphoreDemoButton_Click" />
                    <Button x:Name="taskDemoButton" Content="Task (TPL)"
                            Width="120" Height="30" Margin="0,0,6,6"
                            Click="taskDemoButton_Click" />
                    <Button x:Name="parallelForButton" Content="Parallel.For"
                            Width="120" Height="30" Margin="0,0,6,6"
                            Click="parallelForButton_Click" />
                    <Button x:Name="asyncDemoButton" Content="Async/Await"
                            Width="130" Height="30" Margin="0,0,6,6"
                            Click="asyncDemoButton_Click" />
                </WrapPanel>
            </StackPanel>

            <!-- Лог: анализ потоков каждые 1000 мс и вывод демонстраций -->
            <GroupBox Grid.Row="1" Header="Лог (анализ состояния потоков и демонстрации)">
                <ListBox x:Name="logList" FontFamily="Consolas" FontSize="12" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
